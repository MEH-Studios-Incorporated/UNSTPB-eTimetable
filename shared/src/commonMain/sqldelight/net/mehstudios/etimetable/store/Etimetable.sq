--
-- The offline copy. Data is kept as JSON documents: the dataset is a few
-- hundred kilobytes and always read whole. Statements stay within SQLite
-- 3.18 (Android 8), so no UPSERT.

CREATE TABLE dataset_cache (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    etag TEXT,
    json TEXT NOT NULL,
    checked_at INTEGER NOT NULL
);

selectDataset:
SELECT etag, json, checked_at FROM dataset_cache WHERE id = 1;

saveDataset:
INSERT OR REPLACE INTO dataset_cache (id, etag, json, checked_at) VALUES (1, ?, ?, ?);

markDatasetChecked:
UPDATE dataset_cache SET checked_at = ? WHERE id = 1;

CREATE TABLE announcement (
    id TEXT NOT NULL PRIMARY KEY,
    published_at INTEGER NOT NULL,
    pinned INTEGER NOT NULL,
    read INTEGER NOT NULL DEFAULT 0,
    json TEXT NOT NULL
);

insertAnnouncementIfNew:
INSERT OR IGNORE INTO announcement (id, published_at, pinned, read, json) VALUES (?, ?, ?, 0, ?);

updateAnnouncement:
UPDATE announcement SET published_at = ?, pinned = ?, json = ? WHERE id = ?;

selectAnnouncements:
SELECT json, read FROM announcement ORDER BY pinned DESC, published_at DESC;

markAnnouncementRead:
UPDATE announcement SET read = 1 WHERE id = ?;

markAllAnnouncementsRead:
UPDATE announcement SET read = 1;

markAnnouncementUnread:
UPDATE announcement SET read = 0 WHERE id = ?;

countUnread:
SELECT count(*) FROM announcement WHERE read = 0;

-- announcements the faculty deleted from the dashboard
deleteAnnouncementsExcept:
DELETE FROM announcement WHERE id NOT IN ?;

deleteAllAnnouncements:
DELETE FROM announcement;

CREATE TABLE profile (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    json TEXT NOT NULL,
    dirty INTEGER NOT NULL
);

selectProfile:
SELECT json, dirty FROM profile WHERE id = 1;

saveProfile:
INSERT OR REPLACE INTO profile (id, json, dirty) VALUES (1, ?, ?);

deleteProfile:
DELETE FROM profile;

-- Events, as the server sends them: one JSON list with its ETag, read whole.
-- Pictures are not here; the app's image cache keeps them.
CREATE TABLE events_cache (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    etag TEXT,
    json TEXT NOT NULL
);

selectEvents:
SELECT etag, json FROM events_cache WHERE id = 1;

saveEvents:
INSERT OR REPLACE INTO events_cache (id, etag, json) VALUES (1, ?, ?);

-- Changes to the student's own classes, found when a sync brings a new dataset.
-- One row per class and kind of change; the note is JSON (ChangeNote).
CREATE TABLE change_note (
    activity_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    seen_at INTEGER NOT NULL,
    json TEXT NOT NULL,
    PRIMARY KEY (activity_id, kind)
);

selectChangeNotes:
SELECT json FROM change_note ORDER BY seen_at;

insertChangeNote:
INSERT OR REPLACE INTO change_note (activity_id, kind, seen_at, json) VALUES (?, ?, ?, ?);

deleteChangeNotesBefore:
DELETE FROM change_note WHERE seen_at < ?;

deleteAllChangeNotes:
DELETE FROM change_note;
