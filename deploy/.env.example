#
# Copy to deploy/.env and fill in. Every setting the server reads is listed
# here; nothing else is needed to run it.

# Port on the host machine
ETT_PUBLIC_PORT=8080

# PostgreSQL; set a long random password before the first start
ETT_DB_NAME=etimetable
ETT_DB_USER=etimetable
ETT_DB_PASSWORD=change-me

# Address students and admins reach the server at. With https:// the
# dashboard's login cookie is only sent over HTTPS.
ETT_PUBLIC_URL=

# First dashboard account, created on start while there is no admin yet.
# Change the password in the dashboard afterwards and clear these.
ETT_ADMIN_EMAIL=
ETT_ADMIN_PASSWORD=
