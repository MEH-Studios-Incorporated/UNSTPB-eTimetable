#
# Copy to deploy/.env and fill in. Every setting the server reads is listed
# here; nothing else is needed to run it.

# Port on the host machine
ETT_PUBLIC_PORT=8080

# PostgreSQL (used by the database PR; set a long random password)
ETT_DB_NAME=etimetable
ETT_DB_USER=etimetable
ETT_DB_PASSWORD=change-me
